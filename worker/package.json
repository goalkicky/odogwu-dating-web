{
  "name": "odogwu-worker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute odogwu-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute odogwu-db --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250806.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.99.0"
  }
}
